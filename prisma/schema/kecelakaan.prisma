// ════════════════════════════════════════════════════════════════════════════
//  ENCOUNTER: Kecelakaan  (Postgres schema "encounter")
//  Tab "Data Kecelakaan" registrasi (detail kunjungan) — dasar klaim Jasa Raharja
//  (KLL) / BPJS Ketenagakerjaan (kecelakaan kerja). 1:1 per kunjungan.
//
//  Enum FE-facing = TEXT + validasi Zod (bukan enum DB) — vocab UI (kll/kerja/lainnya,
//  status LP/JR/klaim). kendaraan = snapshot JSONB [{ jenis, noPol, peran }].
//  Konvensi (FLOWS §9): uuid v7 · timestamptz · soft-delete · optimistic version.
// ════════════════════════════════════════════════════════════════════════════

model Kecelakaan {
  id String @id @default(uuid(7)) @db.Uuid

  /// 1:1 — data kecelakaan untuk kunjungan ini.
  kunjunganId String    @unique @map("kunjungan_id") @db.Uuid
  kunjungan   Kunjungan @relation(fields: [kunjunganId], references: [id], onDelete: Cascade)

  jenis String @default("kll") // kll | kerja | lainnya

  // ── Kejadian (shared) ──
  tglKejadian     DateTime? @map("tgl_kejadian") @db.Date
  waktuKejadian   String?   @map("waktu_kejadian") // "HH:MM"
  provinsi        String?
  lokasi          String?
  kronologi       String?
  mekanismeTrauma String?   @map("mekanisme_trauma")

  // ── KLL (Jasa Raharja) ──
  statusLp           String? @map("status_lp")            // belum | proses | ada
  noLapPol           String? @map("no_lap_pol")
  satuanPolisi       String? @map("satuan_polisi")
  kendaraan          Json    @default("[]") @db.JsonB     // [{ jenis, noPol, peran }]
  penjaminLanjutan   String? @map("penjamin_lanjutan")
  statusKoordinasiJr String? @map("status_koordinasi_jr") // belum | dijadwalkan | verifikasi

  // ── Kecelakaan Kerja (BPJS Ketenagakerjaan / JKK · e-PLKK) ──
  // JKK ditanggung BPJS TK (bukan JKN). Rel utama = e-PLKK + Form KK1/KK2/KK3; SEP hanya jejak
  // CoB kondisional (bila pasien JKN). Lihat docs/KECELAKAAN-KERJA-JKK.md.
  namaPerusahaan  String? @map("nama_perusahaan")
  npp             String?                            // Nomor Pendaftaran Perusahaan (BPJS TK) — Form KK1
  noKpj           String? @map("no_kpj")             // No. Kartu Peserta BPJS TK (eligibilitas e-PLKK)
  jenisPekerjaan  String? @map("jenis_pekerjaan")
  lokasiKerja     String? @map("lokasi_kerja")
  lingkupKerja    String? @map("lingkup_kerja")      // tempat_kerja | dinas | pp (berangkat-pulang)
  statusLaporanKk String? @map("status_laporan_kk")  // belum | proses | terkirim (Laporan Tahap I / KK1, maks 2×24 jam)
  isPlkk          Boolean @default(true) @map("is_plkk") // RS PLKK (direct-bill) vs non-PLKK (reimburse)
  // Badan penyelenggara penjamin kecelakaan (kode SEP jaminan.penjamin, koma-join): "2"=BPJS TK ·
  // "1,2"=Jasa Raharja+BPJS TK (KLL_KK / PP-laka). Derivasi server dari jenis+lingkup+kendaraan.
  penjaminBadan   String? @map("penjamin_badan")
  // Hasil PENETAPAN penjaminan JKK oleh BPJS TK via e-PLKK (bukan CoB; PMK 141/2018). RS melapor,
  // BPJS TK menetapkan: menunggu | dijamin (JKK unlimited direct-bill) | ditolak (→ fallback JKN).
  statusPenjaminanKk String? @map("status_penjaminan_kk") // menunggu | dijamin | ditolak
  noJaminanKk        String? @map("no_jaminan_kk")        // No. Jaminan / Kasus e-PLKK saat dijamin

  // ── Suplesi BPJS (perawatan lanjutan KLL) — dipetakan ke SEP.jaminan.penjamin.suplesi ──
  // Jembatan Kecelakaan→SEP: kunjungan lanjutan kecelakaan yang sama ditandai suplesi merujuk
  // No. SEP awal (episode 1 kecelakaan). Kode wilayah kejadian (lokasiLaka) DITUNDA → butuh
  // referensi wilayah BPJS (kode ≠ Kemendagri); disambung saat referensi+mapping BPJS aktif.
  suplesi      Boolean @default(false)
  noSepSuplesi String? @map("no_sep_suplesi")

  // ── Status klaim ──
  statusKlaim String  @default("belum") @map("status_klaim") // belum | proses | selesai | ditolak
  nomorKlaim  String? @map("nomor_klaim")

  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("kecelakaan")
  @@schema("encounter")
}
