/// Peta resource lokal ↔ id SatuSehat. Resolve-first, anti create ganda (R8/R15).
model ResourceMap {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// mock | sandbox | prod — IHS id BERBEDA per environment (id sandbox tak berlaku di prod,
  /// id mock palsu) → peta dipisah per env agar ganti SATUSEHAT_MODE tak memakai id basi.
  env          String
  /// Patient | Practitioner | Organization | Location | Encounter | Condition | ...
  localType    String   @map("local_type")
  /// PK domain lokal (pasienId/kunjunganId/diagnosaId/...) — soft-ref lintas schema, tanpa FK.
  localId      String   @map("local_id")
  /// FHIR resourceType (biasanya = localType; beda bila 1 domain → >1 resource).
  resourceType String   @map("resource_type")
  /// Logical id SatuSehat.
  ihsId        String   @map("ihs_id")
  /// meta.versionId terakhir.
  versionId    String?  @map("version_id")
  /// sha256 payload terkirim (deteksi perubahan → PUT).
  hash         String?
  /// Kunjungan pemilik (resource klinis per kunjungan). NULL = master (Org/Location/Practitioner/Patient).
  kunjunganId  String?  @map("kunjungan_id") @db.Uuid
  lastSyncAt   DateTime @map("last_sync_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([env, localType, localId])
  @@index([env, resourceType, ihsId])
  @@index([env, kunjunganId])
  /// Konsol Resource: daftar per resourceType terbaru dulu.
  @@index([env, resourceType, lastSyncAt(sort: Desc)])
  @@map("resource_map")
  @@schema("fhir")
}

/// Outbox kiriman (R4). Aksi klinis commit → Pending → worker kirim → Acked/Failed.
model SyncLog {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// encounter.complete | diagnosa.create | onboarding.organization | ...
  trigger     String
  kunjunganId String?    @map("kunjungan_id") @db.Uuid
  /// transaction | single
  bundleType  String     @map("bundle_type")
  /// Bundle / resource (JSONB). Berisi PII klinis — JANGAN di-log (R14).
  payload     Json
  status      SyncStatus @default(Pending)
  attempts    Int        @default(0)
  /// OperationOutcome terakhir (ringkas).
  lastError   Json?      @map("last_error")
  /// Hasil: [{resourceType, localId?, ihsId}].
  ihsRefs     Json?      @map("ihs_refs")
  /// Jadwal coba-ulang berikutnya (backoff worker).
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([kunjunganId])
  @@map("sync_log")
  @@schema("fhir")
}

enum SyncStatus {
  Pending
  Sending
  Acked
  Failed
  Skipped

  @@schema("fhir")
}

/// Audit tiap panggilan SatuSehat (5 thn). Mirror bpjs.BpjsAuditLog; PII di-hash (R9/R14).
model FhirAuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  startedAt      DateTime @map("started_at") @db.Timestamptz(3)
  mode           String // mock | sandbox | prod
  target         String // fhir | kfa | masterdata | oauth | kyc
  /// Path dengan placeholder (TANPA PII), mis. "Patient?identifier={nik}".
  endpoint       String
  method         String
  resourceType   String?  @map("resource_type")
  ihsId          String?  @map("ihs_id")
  requestHash    String?  @map("request_hash")
  responseStatus String   @map("response_status") // HTTP status / "ERR"
  success        Boolean
  durationMs     Int      @map("duration_ms")
  errorType      String?  @map("error_type")
  retryCount     Int      @default(0) @map("retry_count")
  nikHash        String?  @map("nik_hash")
  actor          String
  actorRole      String   @map("actor_role")
  idempotencyKey String?  @map("idempotency_key")
  /// Data lokal yang dikirim/dicari (Organization/Location/Practitioner/Patient/klinis · "Bundle").
  localType      String?  @map("local_type")
  /// PK lokal; Bundle = kunjunganId.
  localId        String?  @map("local_id")
  kunjunganId    String?  @map("kunjungan_id") @db.Uuid
  /// Isi Bundle transaction berurutan "<localType>|<localId>" (indeks = nomor entry).
  localRefs      String[] @map("local_refs")
  /// Path nyata (NIK dimasker).
  requestPath    String?  @map("request_path")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  payload        FhirAuditPayload?

  @@index([startedAt])
  @@index([target, endpoint])
  @@index([mode, localType, localId, startedAt(sort: Desc), id(sort: Desc)], map: "fhir_audit_log_local_idx")
  @@index([mode, kunjunganId, startedAt(sort: Desc), id(sort: Desc)], map: "fhir_audit_log_kunjungan_idx")
  @@map("fhir_audit_log")
  @@schema("fhir")
}

/// Isi request/response 1 panggilan (1:1 audit). TERENKRIPSI AES-256-GCM (encryptPii); NIK & token tak
/// pernah tersimpan (identifier dimasker, target oauth tak dicatat). Dipangkas setelah masa retensi
/// (SATUSEHAT_LOG_BODY_DAYS) — baris audit tetap 5 tahun.
model FhirAuditPayload {
  auditId       String       @id @map("audit_id") @db.Uuid
  audit         FhirAuditLog @relation(fields: [auditId], references: [id], onDelete: Cascade)
  requestEnc    String?      @map("request_enc")
  responseEnc   String?      @map("response_enc")
  requestBytes  Int?         @map("request_bytes")
  responseBytes Int?         @map("response_bytes")
  /// Body melebihi batas simpan → dipotong (disimpan sebagai teks, bukan JSON utuh).
  truncated     Boolean      @default(false)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("fhir_audit_payload")
  @@schema("fhir")
}
