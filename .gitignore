# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# cache/log npm lokal (dipindah ke folder project agar tak memenuhi disk C)
/.codenpm/

# cache eslint (npm run lint / check:changed)
.eslintcache

# kamus SNOMED CT dari Kemenkes (lisensi SNOMED + ±157 MB) — di-seed lokal via prisma/scripts/seed-snomed.mts
/docs/snomend_ct.sql

# lampiran terminologi resmi SatuSehat (LOINC lab, dst.) — unduhan lokal, di-seed via prisma/scripts/seed-*.mts
/docs/terminologi/
